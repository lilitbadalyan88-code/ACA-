# Скопируйте этот файл в .env.local и впишите свои значения.
# Файл .env.local никогда не попадает в GitHub.
# Всё, что без приставки NEXT_PUBLIC_, видно только серверу.

# --- Supabase (этап 2) ---
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# «Publishable key» (в старых проектах «anon public»). Его можно видеть браузеру.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# «Secret key» (в старых проектах «service_role»). Только сервер! Никому не показывать.
SUPABASE_SECRET_KEY=

# Любая длинная случайная строка: защищает ежедневную очистку старых фото.
CRON_SECRET=

# --- AI генерация (этап 4) ---
# mock — бесплатные картинки-заглушки для проверки; gemini — настоящая генерация.
AI_PROVIDER=mock
GEMINI_API_KEY=
