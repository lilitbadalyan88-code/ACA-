# Скопируйте этот файл в .env.local и впишите свои значения.
# Файл .env.local никогда не попадает в GitHub.
# Всё, что без приставки NEXT_PUBLIC_, видно только серверу.

# --- Supabase (этап 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI генерация (этап 4) ---
# mock — бесплатные картинки-заглушки для проверки; gemini — настоящая генерация.
AI_PROVIDER=mock
GEMINI_API_KEY=
